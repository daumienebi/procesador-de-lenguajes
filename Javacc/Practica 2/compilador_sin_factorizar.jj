PARSER_BEGIN(MiniCompilador)

public class MiniCompilador {
    public static void main (String[] args) throws Exception {
	Compilador parser = new Compilador (System.in);
	System.out.println (parser.parse ());
    }
}

PARSER_END(MiniCompilador)

//En el bloque SKIP irán los caracteres que no queremos procesar
SKIP :
{
    " " | "\t" | "\n" | "\r"
|   <comentarioLinea : "^^" (~["\n"])* >
|   <comentarioMultilinea : "^." (~["."] | "." ~["^"]) ".^" >
}


// Los identificadores
TOKEN :
{
  < NUM: ( ["0"-"9"] )+ >
| < ID : (["a"-"z","A"-"Z"] (["a"-"z","A"-"Z"] | ["0"-"9"])* )+>
}

TOKEN: /* Los operadores */
{
    < MAS: "+" >
|   < MENOS: "-" >
|   < MULTIPLICACION: "*" >
|   < DIVIDIR: "/" >
}

// Los tokenes de asignacion
TOKEN:
{
    <IGUAL : ":>" >
|   <MAS_IGUAL : ":+>" >
|   <MENOS_IGUAL :":->" >
}

// Palabras reservadas
TOKEN :
{
    <SI : "si" >
|   <SINO : "sino">
|   <SINOSI : "sinosi">
|   <BUCLE : "bucle">
|   <MIENTRAS : "mientras">
|   <INICIO : "inicio">
|   <FIN : "fin">
|   <ASIGNAR : "asignar">
}

// Los simbolos
TOKEN :
{
    <PAREN_A : "(" >
|   <PAREN_C : ")" >
}

// Despues de los tokens, defino las reglas de producciones despues del bloque
// de los tokens

void Programa():{}
{
    ( Sentencia() )+
}

void Sentencia():{}
{
    Asigna()
|   Condicional()
|   Bucle()
|   Bloque()
}

void Asigna():{}
{
    <ASIGNAR> Expr() <IGUAL> <ID>
|   <ASIGNAR> Expr() <MAS_IGUAL> <ID>
|   <ASIGNAR> Expr() <MENOS_IGUAL> <ID>
}

void Condicional():{}
{
    <SI> Expr() Bloque() ElseRep()
|   <SI> Expr() Bloque()
}


void Bucle():{}
{
    <BUCLE> Bloque() <MIENTRAS> Expr()
}

void Bloque():{}
{
    <INICIO> ( Sentencia() )+ <FIN>
}

void Expr(): {}
{
    Mexpr() <MAS> Expr()
|   Mexpr() <MENOS> Expr()
|   Mexpr()
}

// Este Mexpr sirve para diferenciar entre la expresión normal y esta que
// incluye las multiplicaciones y divisiones
void Mexpr(): {}
{
    Valor() <DIVIDIR> Mexpr()
|   Valor() <MULTIPLICACION> Mexpr()
|   Valor()
}

void ElseRep():{}
{
    <SINO> Bloque()
|   <SINOSI> Expr() Bloque() ElseRep()
}

void Valor(): {}
{
    <ID>
|   <NUM>
|   <PAREN_A> Expr() <PAREN_C>
}