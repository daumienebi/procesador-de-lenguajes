PARSER_BEGIN(MiniCompilador)
import java.io.FileInputStream;
import java.io.InputStream;
public class MiniCompilador {

    // Variable para contar las etiquetas
    static private int nextNumber=0;
    // Metodo para gestionar las etiquetas
    private static int getNextNumber() {
        return ++nextNumber;
    }

    public static void main(String args []) {
            InputStream input;
            try {
                if (args.length > 0) {
                    // Si hay argumento: lee del fichero
                    input = new FileInputStream(args[0]);
                } else {
                    input = System.in;
                }
                MiniCompilador parser = new MiniCompilador(input);
                parser.Programa(); // inicio de nuestro analisis
            } catch (java.io.FileNotFoundException e) {
                System.out.println("Error: No se ha encontrado el fichero "+ args[0]);
            } catch (ParseException e) {
                     System.out.println("Error de sintaxis: " + e.getMessage());
            }
        }
}
PARSER_END(MiniCompilador)

//En el bloque SKIP irán los caracteres que no queremos procesar
SKIP :
{
    " " | "\t" | "\n" | "\r"
|   <comentarioLinea : "^^" (~["\n"])* >
}

// Gestionamos los comentarios multilinea con condiciones de arranque

SKIP :
{
    <INI_COM : "^."> {} : dentro_comentario
}

<dentro_comentario> SKIP:
{
    <FIN_COM : ".^"> {} : DEFAULT
|   <CUALQUIER_COSA : ~[]> // no hacer nada ante cualquier caracter dentro del un comentario multilinea
}

TOKEN: /* Los operadores */
{
    < MAS: "+" >
|   < MENOS: "-" >
|   < MULTIPLICACION: "*" >
|   < DIVIDIR: "/" >
}

// Los tokenes de asignacion
TOKEN:
{
    <IGUAL : ":>" >
|   <MAS_IGUAL : ":+>" >
|   <MENOS_IGUAL :":->" >
}

// Palabras reservadas
TOKEN :
{
    <SI : "si" >
|   <SINO : "sino">
|   <SINOSI : "sinosi">
|   <BUCLE : "bucle">
|   <MIENTRAS : "mientras">
|   <INICIO : "inicio">
|   <FIN : "fin">
|   <ASIGNAR : "asignar">
}

// Los simbolos
TOKEN :
{
    <PAREN_A : "(" >
|   <PAREN_C : ")" >
}

// Los identificadores
// Los identificadores tienen que estar aqui abajo, despues de las palabras reservadas etc..
// Por que si no, se van a reconocer todas las palabras reservadas como <ID>
// Recordamos que cuando javacc puede interpretar dos exp. reg. se queda con la que aparezca antes
// en las definiciones de las exp. reg. Entonce ponemos los identificadores aqui abajo para no interferir.
TOKEN :
{
  < NUM: ( ["0"-"9"] )+ >
| < ID : (["a"-"z","A"-"Z"] (["a"-"z","A"-"Z"] | ["0"-"9"])* )+>
}

// Despues de los tokens, defino las reglas de producciones
void Programa():
{}
{
    ( Sentencia() )+
}

void Sentencia():{}
{
    Asigna()
|   Condicional()
|   Bucle()
|   Bloque()
}

//Factorizado por la ambigüedad de la parte <ASIGNAR> Expr()
void Asigna():{
    // Declaro tokenes para almacenar el tipo de operacion e id
    Token tkTipoOp;
    Token tkId;
    String codigoExpr = ""; // Para lo que nos devuelve Expr
}
{
    <ASIGNAR>
    codigoExpr = Expr() (tkTipoOp = <IGUAL>| tkTipoOp = <MAS_IGUAL> | tkTipoOp = <MENOS_IGUAL>)
              tkId = <ID>
              {
                System.out.println("\tvalori " + tkId.image);

                //Imprimimos lo que nos devolvió expr, pero tratamos de
                // imprimir el valord primero
                if(tkTipoOp.image.equals(":+>") || tkTipoOp.image.equals(":->")){
                    System.out.println("\tvalord " + tkId.image);
                }
                System.out.print(codigoExpr);
                // Ahora pasamos a la parte de asignar
                if(tkTipoOp.image.equals(":+>")){
                    System.out.println("\tsum");
                }else if(tkTipoOp.image.equals(":->")){
                    System.out.println("\tsub");
                }
                System.out.println("\tasigna");
              }
}

//Factorizado por la ambigüedad de la parte <SI> Expr()
void Condicional():
{
    int lblFalse = getNextNumber();
    int lblFinal = 0; // puede que no haya otra condicion entonces seria el mismo LBL
    boolean existeElse = false;
    String codCondicion = "";
}
{
    // Que sentido tiene esto?
    //<SI> Expr() Bloque()( ElseRep() | Bloque())
    // Los [] indica que esa ultima parte podria no aparecer
    <SI> codCondicion = Expr()
    {
        // Imprimimos la condicion
        System.out.print(codCondicion);
        // Imprimimos el salto
        System.out.println("\tsifalsovea LBL" + lblFalse);
    }
    Bloque()
    [
    {
     // Obtenemos la etiqueta ahora porque lo necesitamos. Asi evitamos conteos raros
     lblFinal = getNextNumber();
     System.out.println("\tvea LBL" + lblFinal);
     System.out.println("LBL" + lblFalse);
    }
    ElseRep(lblFinal) {existeElse = true;}
    ] {
        // Si no hubo un else
        if(!existeElse){
            System.out.println("LBL" + lblFalse);
        }else{
            System.out.println("LBL" + lblFinal);
        }
    }
}

void Bucle():
{
    int lblInicio = getNextNumber();
    String codCondicion = "";
}
{
    <BUCLE> {System.out.println("LBL" + lblInicio);}
    Bloque()
    <MIENTRAS>
    codCondicion = Expr()
    {
        // Imprimimos la condicion
        System.out.print(codCondicion);
        // Imprimimos el salto
        System.out.println("\tsiciertovea LBL" + lblInicio);
    }
}

void Bloque():{}
{
    <INICIO> ( Sentencia() )+ <FIN>
}

String Expr():
{
    String codIzq = "";
    String codDer = "";
}
{
    codIzq = Mexpr()
    ( <MAS> codDer = Mexpr() { codIzq = codIzq + codDer + "\tsum\n"; }
    | <MENOS> codDer = Mexpr() { codIzq = codIzq + codDer + "\tsub\n"; }
    )*
    { return codIzq; } // porque puede que no entre en la zona de sum y sub
    //Mexpr() ( <MAS> Expr() | <MENOS> Expr()) | Mexpr()
}

// Este Mexpr sirve para diferenciar entre la expresión normal y esta que
// incluye las multiplicaciones y divisiones
String Mexpr():
{
    String codIzq = "";
    String codDer = "";
}
{
    codIzq = Valor()
    ( <DIVIDIR> codDer = Valor() {codIzq = codIzq + codDer + "\tdiv\n";}
    | <MULTIPLICACION> codDer = Valor() {codIzq = codIzq + codDer + "\tmul\n";}
    )*
    { return codIzq; } // porque puede que no entre en la zona de div y mul
}

void ElseRep(int lblFinal):
{
    int lblFalse = 0;
    String codCondicion = "";
}
{
    <SINO> Bloque()
|   <SINOSI> {lblFalse = getNextNumber();} // necesitamos la etiqueta si entra aqui
    codCondicion = Expr()
    {
        // Imprimir condicon
        System.out.print(codCondicion);
        //Imprimir salto
        System.out.println("\tsifalsovea LBL" + lblFalse);
    }
    Bloque()
    {System.out.println("\tvea LBL" + lblFinal);
     System.out.println("LBL" + lblFalse);
    }
    [ ElseRep(lblFinal) ] // Puede no aparecer
}

String Valor(): {
    Token tk;
    String codExpr = "";
}
{
    tk = <ID> {return "\tvalord " + tk.image + "\n";}
|   tk = <NUM> {return "\tmete " + tk.image + "\n" ;}
|   <PAREN_A> codExpr = Expr() <PAREN_C>
    { return codExpr; }
}