PARSER_BEGIN(MiniCompilador)
import java.io.FileInputStream;
import java.io.InputStream;
public class MiniCompilador {

    // Variable para contar las etiquetas
    static private int nextNumber=0;
    // Metodo para gestionar las etiquetas
    private static int getNextNumber() {
        return ++nextNumber;
    }

    public static void main(String args []) {
            InputStream input;
            try {
                if (args.length > 0) {
                    // Si hay argumento: lee del fichero
                    input = new FileInputStream(args[0]);
                } else {
                    input = System.in;
                }
                MiniCompilador parser = new MiniCompilador(input);
                parser.Programa(); // inicio de nuestro analisis
            } catch (java.io.FileNotFoundException e) {
                System.out.println("Error: No se ha encontrado el fichero "+ args[0]);
            } catch (ParseException e) {
                     System.out.println("Error de sintaxis: " + e.getMessage());
            }
        }
}
PARSER_END(MiniCompilador)

//En el bloque SKIP irán los caracteres que no queremos procesar
SKIP :
{
    " " | "\t" | "\n" | "\r"
|   <comentarioLinea : "^^" (~["\n"])* >
}

// Gestionamos los comentarios multilinea con condiciones de arranque

SKIP :
{
    <INI_COM : "^."> {} : dentro_comentario
}

<dentro_comentario> SKIP:
{
    <FIN_COM : ".^"> {} : DEFAULT
|   <CUALQUIER_COSA : ~[]> // no hacer nada ante cualquier caracter dentro del un comentario multilinea
}

TOKEN: /* Los operadores */
{
    < MAS: "+" >
|   < MENOS: "-" >
|   < MULTIPLICACION: "*" >
|   < DIVIDIR: "/" >
}

// Los tokenes de asignacion
TOKEN:
{
    <IGUAL : ":>" >
|   <MAS_IGUAL : ":+>" >
|   <MENOS_IGUAL :":->" >
}

// Palabras reservadas
TOKEN :
{
    <SI : "si" >
|   <SINO : "sino">
|   <SINOSI : "sinosi">
|   <BUCLE : "bucle">
|   <MIENTRAS : "mientras">
|   <INICIO : "inicio">
|   <FIN : "fin">
|   <ASIGNAR : "asignar">
}

// Los simbolos
TOKEN :
{
    <PAREN_A : "(" >
|   <PAREN_C : ")" >
}

// Los identificadores
// Los identificadores tienen que estar aqui abajo, despues de las palabras reservadas etc..
// Por que si no, se van a reconocer todas las palabras reservadas como <ID>
// Recordamos que cuando javacc puede interpretar dos exp. reg. se queda con la que aparezca antes
// en las definiciones de las exp. reg. Entonce ponemos los identificadores aqui abajo para no interferir.
TOKEN :
{
  < NUM: ( ["0"-"9"] )+ >
| < ID : (["a"-"z","A"-"Z"] (["a"-"z","A"-"Z"] | ["0"-"9"])* )+>
}

// Despues de los tokens, defino las reglas de producciones
void Programa():
{}
{
    ( Sentencia() )+
}

void Sentencia():{}
{
    Asigna()
|   Condicional()
|   Bucle()
|   Bloque()
}

//Factorizado por la ambigüedad de la parte <ASIGNAR> Expr()
void Asigna():{
    // Declaro tokenes para almacenar el tipo de operacion e id
    Token tkTipoOp;
    Token tkId;
}
{
    <ASIGNAR> Expr() (tkTipoOp = <IGUAL>| tkTipoOp = <MAS_IGUAL> | tkTipoOp = <MENOS_IGUAL>)
              tkId = <ID>
              {
                System.out.println("\tvalori" + tkId.image);

                // Ahora pasamos a la parte de asignar
                if(tkTipoOp.image.equals(":+>")){
                    System.out.println("\tsum");
                }else if(tkTipoOp.image.equals(":->")){
                    System.out.println("\tsub");
                }
                System.out.println("\tasigna");
              }
}

//Factorizado por la ambigüedad de la parte <SI> Expr()
void Condicional():{}
{
    // Que sentido tiene esto?
    //<SI> Expr() Bloque()( ElseRep() | Bloque())

    // Los [] indica que esa ultima parte podria no aparecer
    <SI> Expr() Bloque() [ ElseRep() ]
}

void Bucle():{}
{
    <BUCLE> Bloque() <MIENTRAS> Expr()
}

void Bloque():{}
{
    <INICIO> ( Sentencia() )+ <FIN>
}

void Expr(): {}
{
    Mexpr() [ <MAS> Expr() {System.out.println("\tsum");}
    |         <MENOS> Expr() {System.out.println("\tsub");}
            ]
    //Mexpr() ( <MAS> Expr() | <MENOS> Expr()) | Mexpr()
}

// Este Mexpr sirve para diferenciar entre la expresión normal y esta que
// incluye las multiplicaciones y divisiones
void Mexpr(): {}
{
    Valor() [ <DIVIDIR> Mexpr() {System.out.println("\tdiv");}
    |         <MULTIPLICACION> Mexpr() {System.out.println("\tmul");}]
}

void ElseRep():{}
{
    <SINO> Bloque()
|   <SINOSI> Expr() Bloque() ElseRep()
}

void Valor(): {
    Token tk;
}
{
    tk = <ID> {System.out.println("\tvalord " + tk.image);}
|   tk = <NUM> {System.out.println("\tmete " + tk.image);}
|   <PAREN_A> Expr() <PAREN_C>
}